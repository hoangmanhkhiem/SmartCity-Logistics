// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== ORGANIZATION & CARRIER ====================

model Organization {
  id          Int      @id @default(autoincrement())
  name        String
  type        String // Loại hình tổ chức (doanh nghiệp, cơ quan, trường, ...)
  business    String? // Lĩnh vực hoạt động
  description String?  @db.Text
  address     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  carriers    Carrier[]
  facilities  Facility[]
  memberships Membership[]

  @@map("organizations")
}

model Carrier {
  id               Int      @id @default(autoincrement())
  organizationId   Int      @map("organization_id")
  name             String // Tên doanh nghiệp last-mile (VD: FastShip Cầu Giấy)
  operatingZoneIds Json     @default("[]") @map("operating_zone_ids") // Mảng zoneId carrier phục vụ
  serviceType      String   @default("last_mile") @map("service_type")
  contactName      String?  @map("contact_name")
  contactPhone     String?  @map("contact_phone")
  contactEmail     String?  @map("contact_email")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles           Vehicle[]
  orders             Order[]
  routes             Route[]
  shipperProfiles    ShipperProfile[]
  platformApiClients PlatformApiClient[]

  @@map("carriers")
}

// ==================== VEHICLE ====================

model Vehicle {
  id                  Int      @id @default(autoincrement())
  carrierId           Int      @map("carrier_id")
  type                String // Loại xe (bike, van, truck, e-scooter, …)
  plate               String   @unique // Biển số xe
  brand               String? // Hãng xe
  model               String? // Model xe
  year                Int? // Năm sản xuất
  capacity            Float? // Tải trọng (kg)
  volume              Float? // Thể tích (m³)
  fuelType            String?  @map("fuel_type") // Loại nhiên liệu
  isElectric          Boolean  @default(false) @map("is_electric")
  emissionStandard    String?  @map("emission_standard") // EURO 5, etc.
  emissionFactor      Float?   @map("emission_factor") // gCO2e/km
  range               Float? // Phạm vi hoạt động (km)
  currentBatteryLevel Float?   @map("current_battery_level")
  status              String   @default("available") // available, in_use, maintenance
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  carrier         Carrier          @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  telemetries     Telemetry[]
  routes          Route[]
  shipperProfiles ShipperProfile[]

  @@map("vehicles")
}

// ==================== FACILITY & RELATED ====================

model Facility {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  zoneId         Int?     @map("zone_id")
  name           String // Tên điểm trung chuyển / kho / trạm
  kind           String // hub, warehouse, charging_station, fuel_station, mfc
  latitude       Float
  longitude      Float
  address        String?
  capacity       Int? // Công suất
  openingTime    String?  @map("opening_time")
  closingTime    String?  @map("closing_time")
  description    String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zone         Zone?        @relation(fields: [zoneId], references: [id])
  chargers     Charger[]
  fuelPumps    FuelPump[]
  docks        Dock[]

  @@map("facilities")
}

model Charger {
  id            Int      @id @default(autoincrement())
  facilityId    Int      @map("facility_id")
  type          String // AC/DC/fast/slow
  connectorType String?  @map("connector_type") // Type 2, CCS, CHAdeMO
  powerKw       Float    @map("power_kw") // Công suất đầu ra (kW)
  slots         Int      @default(1) // Số khe sạc
  pricePerKwh   Float?   @map("price_per_kwh") // Giá/kWh
  status        String   @default("available") // available, occupied, maintenance
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("chargers")
}

model FuelPump {
  id            Int      @id @default(autoincrement())
  facilityId    Int      @map("facility_id")
  fuelType      String   @map("fuel_type") // RON95, Diesel, E5, …
  pricePerLiter Float?   @map("price_per_liter") // Giá/lít
  status        String   @default("available")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("fuel_pumps")
}

model Dock {
  id         Int      @id @default(autoincrement())
  facilityId Int      @map("facility_id")
  name       String?
  capacity   Int // Số lượng phương tiện tối đa
  status     String   @default("available")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("docks")
}

// ==================== ZONE & ROAD ====================

model Zone {
  id          Int      @id @default(autoincrement())
  name        String // Tên vùng (VD: Ba Đình, Đống Đa, Láng, …)
  type        String? // district, ward, lez, restricted
  description String?  @db.Text
  // Boundary stored as GeoJSON string
  boundary    String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  facilities      Facility[]
  roadSegments    RoadSegment[]
  restrictions    Restriction[]
  orders          Order[]
  routes          Route[]
  shipperProfiles ShipperProfile[]

  @@map("zones")
}

model RoadSegment {
  id         Int      @id @default(autoincrement())
  zoneId     Int?     @map("zone_id")
  name       String // Tên đường
  osmId      String?  @map("osm_id") // OpenStreetMap ID
  // Geometry stored as GeoJSON string
  geometry   String?  @db.Text
  oneWay     Boolean  @default(false) @map("one_way")
  speedLimit Float?   @map("speed_limit") // km/h
  lanes      Int?
  roadType   String?  @map("road_type") // primary, secondary, tertiary
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  zone         Zone?         @relation(fields: [zoneId], references: [id])
  restrictions Restriction[]

  @@map("road_segments")
}

model Restriction {
  id            Int      @id @default(autoincrement())
  roadSegmentId Int?     @map("road_segment_id")
  zoneId        Int?     @map("zone_id")
  vehicleType   String?  @map("vehicle_type") // (legacy) một loại xe
  vehicleTypes  Json     @default("[]") @map("vehicle_types") // rỗng = áp dụng mọi loại
  severity      String   @default("restricted") // prohibited | restricted | allowed_window — map màu bản đồ
  maxWeight     Float?   @map("max_weight") // Tải trọng tối đa (kg)
  maxHeight     Float?   @map("max_height") // Chiều cao tối đa (m)
  timeFrom      String?  @map("time_from") // HH:mm — nếu timeFrom > timeTo = khung qua đêm
  timeTo        String?  @map("time_to") // HH:mm
  daysOfWeek    Json     @map("days_of_week") // [Mon, Tue, ...] — rỗng = mọi ngày
  allowed       Boolean  @default(false) // TRUE nếu được phép lưu thông (legacy / mô tả)
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  roadSegment RoadSegment? @relation(fields: [roadSegmentId], references: [id], onDelete: Cascade)
  zone        Zone?        @relation(fields: [zoneId], references: [id])

  @@map("restrictions")
}

// ==================== PLATFORM API (B2B partner keys) ====================

model PlatformApiClient {
  id        Int      @id @default(autoincrement())
  carrierId Int?     @map("carrier_id")
  name      String
  keyPrefix String   @map("key_prefix")
  keyHash   String   @unique @map("key_hash")
  scopes    Json     @default("[\"orders:create\"]")
  isActive  Boolean  @default(true) @map("isActive")
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")

  carrier Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  orders  Order[]

  @@map("platform_api_clients")
}

// ==================== ORDER ====================

model Order {
  id                  Int       @id @default(autoincrement())
  carrierId           Int       @map("carrier_id")
  customerId          Int?      @map("customer_id")
  zoneId              Int?      @map("zone_id")
  orderNumber         String    @unique @map("order_number")
  trackingNo          String    @unique @map("tracking_no")
  status              String    @default("pending") // pending, assigned, in_transit, delivered, failed, cancelled
  pickupAddress       String?   @map("pickup_address")
  pickupLat           Float?    @map("pickup_lat")
  pickupLon           Float?    @map("pickup_lon")
  pickupPhone         String?   @map("pickup_phone")
  deliveryAddress     String?   @map("delivery_address")
  deliveryLat         Float?    @map("delivery_lat")
  deliveryLon         Float?    @map("delivery_lon")
  deliveryPhone       String?   @map("delivery_phone")
  weightKg            Float?    @map("weight_kg")
  itemCount           Int?      @map("item_count")
  codAmount           Float?    @default(0) @map("cod_amount")
  sourceUrl           String?   @map("source_url")
  externalRef         String?   @map("external_ref")
  fulfillmentChannel  String?   @map("fulfillment_channel")
  platformApiClientId Int?      @map("platform_api_client_id")
  timeWindowStart     DateTime? @map("time_window_start")
  timeWindowEnd       DateTime? @map("time_window_end")
  priority            Int       @default(1) // 1-5
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  carrier           Carrier             @relation(fields: [carrierId], references: [id])
  customer          User?               @relation(fields: [customerId], references: [id])
  zone              Zone?               @relation(fields: [zoneId], references: [id])
  platformApiClient PlatformApiClient?  @relation(fields: [platformApiClientId], references: [id], onDelete: SetNull)
  stops             Stop[]

  @@index([platformApiClientId, externalRef])
  @@index([carrierId, status])
  @@index([zoneId, status])
  @@map("orders")
}

// ==================== ROUTE (chuyến giao 1 xe / 1 shipper / 1 ca) ====================

model Route {
  id                Int       @id @default(autoincrement())
  carrierId         Int       @map("carrier_id")
  vehicleId         Int       @map("vehicle_id")
  shipperId         Int       @map("shipper_id")
  zoneId            Int?      @map("zone_id")
  code              String    @unique // RT-YYYYMMDD-xxxx
  shiftDate         DateTime  @map("shift_date") @db.Date
  status            String    @default("planned") // planned, in_progress, completed, cancelled
  plannedStartAt    DateTime? @map("planned_start_at")
  plannedEndAt      DateTime? @map("planned_end_at")
  actualStartAt     DateTime? @map("actual_start_at")
  actualEndAt       DateTime? @map("actual_end_at")
  totalDistanceKm   Float?    @map("total_distance_km")
  totalDurationMin  Int?      @map("total_duration_min")
  estimatedCo2Grams Float?    @map("estimated_co2_grams")
  // Route geometry as GeoJSON
  geometry          String?   @db.Text
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  shipper User    @relation("RouteShipper", fields: [shipperId], references: [id])
  zone    Zone?   @relation(fields: [zoneId], references: [id])
  stops   Stop[]

  @@index([carrierId, shiftDate])
  @@index([vehicleId, shiftDate])
  @@index([shipperId, shiftDate])
  @@map("routes")
}

model Stop {
  id           Int       @id @default(autoincrement())
  routeId      Int       @map("route_id")
  orderId      Int       @map("order_id")
  sequence     Int // Thứ tự điểm dừng trong route
  type         String // pickup, delivery
  address      String?
  latitude     Float
  longitude    Float
  contactName  String?   @map("contact_name")
  contactPhone String?   @map("contact_phone")
  timeWindowStart DateTime? @map("time_window_start")
  timeWindowEnd   DateTime? @map("time_window_end")
  status       String    @default("pending") // pending, arrived, completed, failed, skipped
  arrivedAt    DateTime? @map("arrived_at")
  completedAt  DateTime? @map("completed_at")
  failedReason String?   @map("failed_reason") // customer_absent, address_wrong, refused, damaged, other

  // Proof of delivery
  podPhotoUrl     String? @map("pod_photo_url")
  podSignatureUrl String? @map("pod_signature_url")
  podNote         String? @map("pod_note")

  // Cash on delivery
  codAmountDue       Float?    @default(0) @map("cod_amount_due")
  codAmountCollected Float?    @default(0) @map("cod_amount_collected")
  codCollected       Boolean   @default(false) @map("cod_collected")
  codCollectedAt     DateTime? @map("cod_collected_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([routeId, sequence])
  @@index([orderId])
  @@map("stops")
}

// ==================== TELEMETRY ====================

model Telemetry {
  id           Int      @id @default(autoincrement())
  vehicleId    Int      @map("vehicle_id")
  timestamp    DateTime @default(now())
  latitude     Float
  longitude    Float
  speed        Float? // km/h
  heading      Float? // degrees
  altitude     Float? // meters
  batteryLevel Float?   @map("battery_level") // %
  fuelLevel    Float?   @map("fuel_level") // %
  engineStatus String?  @map("engine_status")
  odometer     Float? // km
  createdAt    DateTime @default(now())

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, timestamp])
  @@map("telemetry")
}

// ==================== ANALYTICS SNAPSHOT (time-series cho báo cáo) ====================

model AnalyticsSnapshot {
  id                Int      @id @default(autoincrement())
  snapshotDate      DateTime @map("snapshot_date") @db.Date
  carrierId         Int?     @map("carrier_id") // null = toàn nền tảng
  ordersTotal       Int      @default(0) @map("orders_total")
  ordersDelivered   Int      @default(0) @map("orders_delivered")
  ordersFailed      Int      @default(0) @map("orders_failed")
  routesCompleted   Int      @default(0) @map("routes_completed")
  totalDistanceKm   Float?   @map("total_distance_km")
  estimatedCo2Grams Float?   @map("estimated_co2_grams")
  codCollectedTotal Float?   @map("cod_collected_total")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([snapshotDate, carrierId])
  @@map("analytics_snapshots")
}

// ==================== USER & RBAC ====================

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  name        String
  phone       String?
  avatarUrl   String?   @map("avatar_url")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  memberships    Membership[]
  orders         Order[]
  routesAsShipper Route[]        @relation("RouteShipper")
  shipperProfile ShipperProfile?

  @@map("users")
}

model ShipperProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  carrierId        Int      @map("carrier_id")
  licenseNumber    String?  @map("license_number")
  licenseClass     String?  @map("license_class") // A1, A2, B2, ...
  defaultZoneId    Int?     @map("default_zone_id")
  currentVehicleId Int?     @map("current_vehicle_id")
  status           String   @default("off_duty") // off_duty, on_shift, on_break
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carrier        Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  defaultZone    Zone?    @relation(fields: [defaultZoneId], references: [id])
  currentVehicle Vehicle? @relation(fields: [currentVehicleId], references: [id])

  @@map("shipper_profiles")
}

model Membership {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  organizationId Int      @map("organization_id")
  roleId         Int      @map("role_id")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // platform_admin, carrier_ops, shipper, regulator, consumer
  displayName String?  @map("display_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  memberships     Membership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique // manage_vehicle, view_data, etc.
  resource    String // vehicle, facility, order, route, etc.
  action      String // read, write, delete, manage
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now())

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}
