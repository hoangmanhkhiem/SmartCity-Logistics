{
  "name": "@smartcity/api",
  "version": "1.0.0",
  "description": "Backend API for Urban Logistics System",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/db/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/db/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/db/data-source.ts",
    "db:import-research": "powershell -ExecutionPolicy Bypass -File ./scripts/import-research-sql.ps1",
    "db:import-research:dry": "powershell -ExecutionPolicy Bypass -File ./scripts/import-research-sql.ps1 -DryRun",
    "db:seed": "ts-node -r tsconfig-paths/register src/db/seed.ts",
    "backfill:co2": "ts-node -r tsconfig-paths/register src/jobs/backfill-co2.ts",
    "backfill:snapshots": "ts-node -r tsconfig-paths/register src/jobs/backfill-snapshots.ts"
  },
  "keywords": [
    "nestjs",
    "logistics",
    "urban",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "mysql2": "^3.11.0",
    "typeorm": "^0.3.20",
    "@turf/turf": "^7.3.5",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "reflect-metadata": "^0.1.0",
    "rxjs": "^7.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^3.0.0",
    "@types/uuid": "^9.0.8",
    "rimraf": "^5.0.10",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
