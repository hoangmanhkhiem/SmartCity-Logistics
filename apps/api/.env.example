# Local dev KHÔNG Docker — copy thành .env
NODE_ENV=development
PORT=3001
DATABASE_URL=mysql://urban:urban@localhost:3307/logistic
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
MAPBOX_ACCESS_TOKEN=

# Khi chạy API trong Docker: compose ghi đè DATABASE_URL → mysql://urban:urban@mysql:3306/logistic
# Nếu migrate lỗi P1000, đồng bộ user/pass với file .env ở thư mục gốc repo hoặc xóa volume: docker compose down -v
