# --- Database (dùng chung docker compose + Prisma) ---
DB_NAME=logistic
DB_USER=urban
DB_PASSWORD=urban
MYSQL_PORT=3307

# Local host (ngoài Docker): trỏ vào cổng publish của mysql
DATABASE_URL=mysql://urban:urban@localhost:3307/logistic

# Trong Docker, compose tự ghi đè DATABASE_URL = mysql://...@mysql:3306/...

# --- API ---
NODE_ENV=development
API_PORT=3001
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
MAPBOX_ACCESS_TOKEN=
# TomTom Traffic Flow — chỉ Worker gọi. Dừng ở 90% hạn mức tháng.
TOMTOM_API_KEY=
TOMTOM_MONTHLY_LIMIT=20000
# false = chỉ giữ speed_profiles, xoá mẫu thô sau 24 giờ
TOMTOM_RETAIN_RAW=true

# --- Web (Next proxy /api/v1 → API) ---
WEB_PORT=3000
BACKEND_PROXY_TARGET=http://127.0.0.1:3001

# --- Prod images (docker-compose.prod.yml) ---
DOCKER_REGISTRY=ghcr.io/example
IMAGE_TAG=latest
NGINX_HTTP_PORT=80
